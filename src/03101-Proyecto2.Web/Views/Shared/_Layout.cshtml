<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestión de Proyectos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_03101_Proyecto2.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var autenticado = User.Identity?.IsAuthenticated == true;
        var nombre = User.Identity?.Name ?? string.Empty;
        var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        var iniciales = string.Concat(nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(parte => char.ToUpperInvariant(parte[0])));
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        string Activo(string c) => controlador == c ? "active" : string.Empty;
    }

    @if (autenticado)
    {
        <header>
            <nav class="navbar navbar-expand-md navbar-dark app-navbar">
                <div class="container">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <partial name="_Logo" />
                        Gestión de Proyectos
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                            aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menuPrincipal">
                        <ul class="navbar-nav me-auto gap-md-1 my-2 my-md-0">
                            <li class="nav-item">
                                <a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center justify-content-between gap-3 pb-2 pb-md-0">
                            <div class="app-usuario">
                                <span class="app-avatar" aria-hidden="true">@iniciales</span>
                                <span class="app-usuario-nombre">
                                    @nombre
                                    <span class="app-usuario-rol">@rol</span>
                                </span>
                            </div>
                            <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                            </form>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main" class="container app-main flex-grow-1">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container">
            03101 Programación avanzada en web · UNED · 2026
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
