@model IReadOnlyList<ProyectoDto>
@{
    ViewData["Title"] = "Proyectos";
    var esAdministrador = User.IsInRole(Roles.Administrador);
    var activos = Model.Count(p => p.IdEstado == EstadosIds.Activo);
}

<div class="app-encabezado d-flex flex-wrap align-items-end justify-content-between gap-3">
    <div>
        <h1 class="h3 mb-1">Proyectos</h1>
        <p>
            @(esAdministrador ? "Todos los proyectos" : "Proyectos en los que participa")
            · @activos @(activos == 1 ? "activo" : "activos") de @Model.Count
        </p>
    </div>
    @if (esAdministrador)
    {
        <a asp-action="Crear" class="btn btn-primary">Nuevo proyecto</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="app-card p-4 text-center text-body-secondary">
        @(esAdministrador
            ? "Todavía no hay proyectos registrados."
            : "Aún no participa en ningún proyecto. Aparecerán aquí cuando sea responsable de uno o se le asigne una tarea.")
    </div>
}
else
{
    <div class="app-card">
        <div class="table-responsive">
            <table class="table app-tabla mb-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col">Proyecto</th>
                        <th scope="col">Responsable</th>
                        <th scope="col">Inicio</th>
                        <th scope="col">Fin estimado</th>
                        <th scope="col">Tareas completadas</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proyecto in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@proyecto.Id" class="app-tabla-enlace">@proyecto.Nombre</a>
                            </td>
                            <td>@proyecto.Responsable</td>
                            <td class="text-nowrap">@proyecto.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="text-nowrap">@proyecto.FechaFinEstimada.ToString("dd/MM/yyyy")</td>
                            <td><partial name="_Avance" model="(proyecto.TareasCompletadas, proyecto.TotalTareas)" /></td>
                            <td><partial name="_EstadoProyecto" model="proyecto" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
