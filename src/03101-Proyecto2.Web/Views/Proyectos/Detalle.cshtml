@model ProyectoDto
@{
    ViewData["Title"] = Model.Nombre;
    var esAdministrador = User.IsInRole(Roles.Administrador);
    var activo = Model.IdEstado == EstadosIds.Activo;
}

<nav aria-label="Ruta de navegación">
    <ol class="breadcrumb small mb-2">
        <li class="breadcrumb-item"><a asp-action="Index">Proyectos</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Nombre</li>
    </ol>
</nav>

<div class="app-encabezado d-flex flex-wrap align-items-start justify-content-between gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 mb-0">@Model.Nombre</h1>
            <partial name="_EstadoProyecto" model="Model" />
        </div>
        <p>Responsable: @Model.Responsable</p>
    </div>
    @if (esAdministrador)
    {
        <div class="d-flex gap-2">
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
            @if (activo)
            {
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmarCierre">
                    Cerrar proyecto
                </button>
            }
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="app-card p-4 h-100">
            <h2 class="h6 app-titulo-seccion">Descripción</h2>
            @if (string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <p class="text-body-secondary mb-0">Sin descripción.</p>
            }
            else
            {
                <p class="mb-0 app-texto-largo">@Model.Descripcion</p>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="app-card p-4 h-100">
            <h2 class="h6 app-titulo-seccion">Datos del proyecto</h2>
            <dl class="app-datos mb-0">
                <dt>Fecha de inicio</dt>
                <dd>@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>
                <dt>Fecha estimada de fin</dt>
                <dd>@Model.FechaFinEstimada.ToString("dd/MM/yyyy")</dd>
                <dt>Tareas completadas</dt>
                <dd><partial name="_Avance" model="Model" /></dd>
                <dt>Registrado</dt>
                <dd>@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</dd>
            </dl>
        </div>
    </div>
</div>

<div class="app-card p-4 mt-4">
    <h2 class="h6 app-titulo-seccion">Tareas</h2>
    <p class="text-body-secondary mb-0">Aquí se mostrarán las tareas del proyecto.</p>
</div>

@if (esAdministrador && activo)
{
    <div class="modal fade" id="confirmarCierre" tabindex="-1" aria-labelledby="confirmarCierreTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="Cerrar" asp-route-id="@Model.Id" method="post" class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="confirmarCierreTitulo">¿Cerrar el proyecto?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                </div>
                <div class="modal-body">
                    «@Model.Nombre» pasará a estado Cerrado y dejará de contarse entre los proyectos activos.
                    Sus tareas se conservan.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Cerrar proyecto</button>
                </div>
            </form>
        </div>
    </div>
}
