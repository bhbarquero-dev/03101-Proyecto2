@model ProyectoFormViewModel
@{
    var accion = Model.Id is null ? "Crear" : "Editar";
}

<form asp-action="@accion" asp-route-id="@Model.Id" method="post" novalidate class="app-card p-4 app-formulario">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="150" autofocus />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4" maxlength="1000"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="FechaInicio" class="form-label"></label>
            <input asp-for="FechaInicio" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="FechaFinEstimada" class="form-label"></label>
            <input asp-for="FechaFinEstimada" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            <span asp-validation-for="FechaFinEstimada" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="IdResponsable" class="form-label"></label>
        <select asp-for="IdResponsable" asp-items="Model.Responsables" class="form-select">
            <option value="">Seleccione…</option>
        </select>
        <span asp-validation-for="IdResponsable" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        @if (Model.Id is null)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        }
        else
        {
            <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
        }
    </div>
</form>
